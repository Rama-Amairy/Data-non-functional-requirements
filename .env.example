# Copy to .env and fill in your own values. .env is git-ignored.

DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exam_platform

# A full URL overrides every DB_* value above.
# In phase two this is how the app is pointed at the replica after a failover.
# DATABASE_URL=postgresql+psycopg2://postgres:secret@localhost:5432/exam_platform

# Startup reconnection attempts (the basis for measuring RTO).
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY=2

# Create the tables at startup. Set to 0 once Alembic migrations are in use.
DB_AUTO_CREATE=1

# Print every SQL statement.
DB_ECHO=0

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Demonstration controls. With this on, the presentation dashboard may stop and
# start the database containers so the failover can be triggered on screen.
# Leave it off anywhere the API is reachable by anyone else: the endpoint it
# opens stops a database and has no authentication in front of it.
DEMO_CONTROLS=0
# What has to be stopped to take each node of DB_NODES down, in the same order:
# docker:<container> for the compose cluster, pgctl:<data dir> for an instance
# run directly, or an empty entry for a node that may not be stopped. Unset,
# the container names docker/docker-compose.yml produces are assumed.
# DB_NODE_TARGETS=docker:docker-pg_node_1-1,docker:docker-pg_node_2-1
# DB_NODE_TARGETS=,pgctl:/home/you/pg_standby_node2
# pg_ctl is not on PATH on Debian/Ubuntu:
# PG_CTL_BIN=/usr/lib/postgresql/16/bin/pg_ctl
