# Copy to .env and fill in your own values. .env is git-ignored.

DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exam_platform

# A full URL overrides every DB_* value above.
# In phase two this is how the app is pointed at the replica after a failover.
# DATABASE_URL=postgresql+psycopg2://postgres:secret@localhost:5432/exam_platform

# Startup reconnection attempts (the basis for measuring RTO).
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY=2

# Create the tables at startup. Set to 0 once Alembic migrations are in use.
DB_AUTO_CREATE=1

# Print every SQL statement.
DB_ECHO=0

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
