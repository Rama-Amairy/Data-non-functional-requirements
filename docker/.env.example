# Copy to docker/.env and fill in real values. docker/.env is git-ignored
# (covered by the root .gitignore's blanket ".env" rule).
#
# docker compose reads .env from the directory it's invoked from, which is
# why this lives in docker/ next to docker-compose.yml — see README.md's
# "cd docker && docker compose up -d".

# Superuser password (role "postgres"). Used for admin tasks (repmgr
# bootstrap, scripts/enable-sync-replication.sh, scripts/backup-db.sh).
POSTGRES_ADMIN_PASSWORD=change_me_admin

# The application's own database role and database name — these must match
# the root .env's DB_USER/DB_PASSWORD/DB_NAME (or DATABASE_URL) so the app
# can actually connect.
APP_DB_USER=custom_user
APP_DB_PASSWORD=change_me_app
APP_DB_NAME=app_db

# Shared secret repmgr uses between the two nodes for replication and
# cluster-management connections.
REPMGR_PASSWORD=change_me_repmgr
